{
  "entryFile": "src/server.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "spec": {
    "outputDirectory": "src",
    "specVersion": 3,
    "basePath": "/api",
    "operationIdTemplate": "{{controllerName}}_{{method.name}}"
  },
  "controllerPathGlobs": ["src/**/*.controller{.ts,.js}"],
  "routes": {
    "routesDir": "src"
  }
}
