{
  "name": "racedex-api",
  "version": "1.0.0",
  "description": "Open motorsport database (starting with Formula 1) and REST API: race results, lap times, pit stops and more.",
  "main": "src/server.ts",
  "scripts": {
    "build": "npm run swagger && tsc",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "swagger": "tsoa spec-and-routes",
    "prettier": "prettier --write \"{src,data}/**/*.{json,js,ts}\"",
    "prettier:check": "prettier --check \"{src,data}/**/*.{json,js,ts}\"",
    "prepare": "husky",
    "import-db": "tsx data/db-import.ts",
    "export-db": "tsx data/db-export.ts",
    "pretest": "npm run swagger && tsx data/db-import.ts --if-missing",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "predev": "npm run swagger",
    "test:watch": "vitest",
    "docs:db": "tsx data/db-docs.ts"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "express": "^5.1.0",
    "i18next": "^26.7.2",
    "json-2-csv": "^5.6.0",
    "kysely": "^0.29.8",
    "picocolors": "^1.1.1",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.9.1",
    "tsoa": "^6.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@softwaretechnik/dbml-renderer": "^1.0.31",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
