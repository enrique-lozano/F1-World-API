# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Files generated by tsoa (`npm run swagger`, run automatically by
# `npm run build`, `npm run dev` and `npm test`)
src/routes.ts
src/swagger.json

# SQLite database. Generated from `data/csv` on the first run
# (or manually with `npm run import-db`)
*.db
*.db.tmp
*.sqlite
*.db-shm
*.db-wal
*.db-journal

# Environment variables
.env
.env.*

# Logs and reports
logs/
*.log
npm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Test coverage
coverage/
.nyc_output/

# Caches
.eslintcache
.cache/

# OS / editor files
.DS_Store
Thumbs.db

# Python (generators)
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Output of the generators
**/generators/**/temp
**/generators/**/generated
